# Set the same password in the project root .env for the Docker PostgreSQL service.
DATABASE_URL=
# Generate a unique 32+ byte random secret for each environment. Never commit its value.
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
PASSWORD_RESET_ORIGIN=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PocketPerks
SMTP_USE_TLS=true
CLAUDE_API_KEY=
CLAUDE_MODEL=
OUTREACH_SENDER_NAME=The PocketPerks Team
OUTREACH_COMPANY_NAME=VenturesSky Ltd
OUTREACH_WEBSITE=https://pocketperks.co.uk
# Optional: leave blank until an approved business phone number is available.
OUTREACH_PHONE=
INSTANTLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=
LEAD_ELIGIBILITY_MODE=advisory
SEND_MODE=test
INSTANTLY_AUTO_LAUNCH=
FRONTEND_ORIGIN=http://localhost:3000
PERSONALIZATION_CONCURRENCY=1
PERSONALIZATION_BATCH_SIZE=25
# Daily target is new first-touch leads; scheduled follow-ups are additional sends.
OUTREACH_NEW_LEADS_PER_DAY=100
# Automatic activation is deliberately opt-in and also requires SEND_MODE=live.
INSTANTLY_AUTO_LAUNCH=false
